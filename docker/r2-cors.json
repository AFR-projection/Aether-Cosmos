[
  {
    "AllowedOrigins": ["http://localhost:3000", "https://mindvault.dataku.id"],
    "AllowedMethods": ["GET", "HEAD"],
    "AllowedHeaders": [
      "Range",
      "If-Range",
      "If-None-Match",
      "If-Modified-Since"
    ],
    "ExposeHeaders": [
      "Accept-Ranges",
      "Content-Length",
      "Content-Range",
      "Content-Type",
      "ETag",
      "Last-Modified"
    ],
    "MaxAgeSeconds": 3600
  }
]
