# ═══════════════════════════════════════════════════════════
# Aether Cosmos ByAFR / Storage ByAFR — Environment
# Local : cp .env.example .env
# VPS   : cp .env.example .env → nano .env → ./install.sh
# ═══════════════════════════════════════════════════════════

# ── WAJIB ───────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Kunci HMAC + enkripsi app. Min 32 char — `openssl rand -hex 32`.
# Production menolak start kalau kosong. Rotasi bikin Gmail App
# Password dan secret 2FA yang tersimpan tidak terbaca lagi.
SESSION_SECRET=change-me-openssl-rand-hex-32

# Akun master pertama. Password min 10 char.
MASTER_USERNAME=ByAFR
MASTER_PASSWORD=change-this-strong-password-min-10-chars

R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=strogebyafr

# Origin publik: cookie Secure, HSTS, redirect OAuth, link share.
NEXT_PUBLIC_APP_URL=https://storage.example.com

# ── VPS (production) ────────────────────────────────────────
NODE_ENV=production

# Script deploy saja (nginx, certbot, validate) — app tidak membaca.
DEPLOY_DOMAIN=storage.example.com
CERTBOT_EMAIL=admin@example.com
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# true / false / kosong = auto dari skema NEXT_PUBLIC_APP_URL.
COOKIE_SECURE=true
HSTS_ENABLED=true

# Rate limit, cache, queue, realtime. REDIS_DISABLED=true → in-memory.
REDIS_URL=redis://redis:6379
REDIS_DISABLED=false

# ── Opsional ────────────────────────────────────────────────
# Alias lama SESSION_SECRET, dibaca hanya kalau yang itu kosong.
# CSRF_SECRET=

# Fallback NEXT_PUBLIC_APP_URL untuk konteks server-only.
# APP_PUBLIC_URL=https://storage.example.com

# PORT=3000

# Salt hash query analytics Brain — query mentah tidak pernah disimpan.
# BRAIN_QUERY_SALT=random-per-deployment

# Provider embedding dari env; saat ini hanya "none" yang terdaftar.
# BRAIN_EMBEDDING_PROVIDER=none

# ── Dari panel, bukan env ───────────────────────────────────
# Isi env di atas cuma yang bikin app bisa START: kredensial, secret,
# dan hal yang dipakai script deploy. Sisanya diatur dari UI, kena
# efek dalam ~30 detik, tanpa redeploy.
#
# Admin → Settings
#   General    : registrasi on/off, allowlist domain email, maintenance
#   Storage    : quota default, plafon upload, quota bandwidth,
#                umur presigned URL upload & download
#   Security   : durasi session, idle timeout, IP binding, maks session,
#                wajib 2-Step Code
#   Limits     : rate limit API, lockout login per akun & per IP,
#                panjang window lockout
#   Sharing    : link publik on/off, expiry default & maksimum
#   Files      : umur file, auto-hapus trash, ekstensi & MIME
#   Retention  : retensi log aktivitas
#   Email      : limit harian per sender, threshold gagal, cooldown
#
# Gmail App Password → Admin → Email
# OpenRouter key     → /brain/settings
# STORAGE_API_URL / STORAGE_API_KEY → config client MCP (mcp.json)

