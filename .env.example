# ═══════════════════════════════════════════════════════════
# Aether Cosmos ByAFR — Environment
# Local : cp .env.example .env
# VPS   : cp .env.example .env → nano .env → ./install.sh
# ═══════════════════════════════════════════════════════════

# ── REQUIRED ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# App HMAC + encryption key. Min 32 chars. Leave it as it is:
# install.sh generates one when it is still a placeholder or empty.
# Production refuses to start when it is empty. Rotating it makes the
# stored Gmail App Password and embedding API key unreadable
# (2FA/TOTP is unaffected) — re-enter them from Admin → Email.
SESSION_SECRET=change-me-openssl-rand-hex-32

# The first master account. Password min 10 chars.
MASTER_USERNAME=ByAFR
MASTER_PASSWORD=change-this-strong-password-min-10-chars

R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
# An existing deployment MUST keep its old bucket name — the bucket name
# is part of every object's address, so changing it makes every file that
# is already stored unreachable.
R2_BUCKET_NAME=aether-cosmos

# Public origin: Secure cookies, HSTS, OAuth redirects, share links.
NEXT_PUBLIC_APP_URL=https://aether.example.com

# ── VPS (production) ────────────────────────────────────────
NODE_ENV=production

# Deploy scripts only (nginx, certbot, validate) — the app never reads these.
DEPLOY_DOMAIN=aether.example.com
CERTBOT_EMAIL=admin@example.com
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# true / false / empty = derived from the NEXT_PUBLIC_APP_URL scheme.
COOKIE_SECURE=true
HSTS_ENABLED=true

# Rate limit, cache, queue, realtime. REDIS_DISABLED=true → in-memory.
REDIS_URL=redis://redis:6379
REDIS_DISABLED=false

# ── Optional ────────────────────────────────────────────────
# Legacy alias for SESSION_SECRET, read only when that one is empty.
# CSRF_SECRET=

# Fallback for NEXT_PUBLIC_APP_URL in server-only contexts.
# APP_PUBLIC_URL=https://aether.example.com

# PORT=3000

# Hash salt for Brain query analytics — raw queries are never stored.
# BRAIN_QUERY_SALT=random-per-deployment

# Embedding provider from env; only "none" is registered right now.
# BRAIN_EMBEDDING_PROVIDER=none

# ── From the panel, not env ─────────────────────────────────
# The env vars above are only what the app needs to START: credentials,
# secrets, and the values the deploy scripts use. Everything else is set
# from the UI, takes effect within ~30 seconds, and needs no redeploy.
#
# Admin → Settings
#   General    : registration on/off, email domain allowlist, maintenance
#   Storage    : default quota, upload ceiling, bandwidth quota,
#                presigned URL lifetime for upload & download
#   Security   : session duration, idle timeout, IP binding, max sessions,
#                require 2-Step Code
#   Limits     : API rate limits, login lockout per account & per IP,
#                lockout window length
#   Sharing    : public links on/off, default & maximum expiry
#   Files      : file lifetime, trash auto-delete, extensions & MIME
#   Retention  : activity log retention
#   Email      : daily limit per sender, failure threshold, cooldown
#
# Gmail App Password → Admin → Email
# OpenRouter key     → /brain/settings
# STORAGE_API_URL / STORAGE_API_KEY → MCP client config (mcp.json)
